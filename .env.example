# Proxy Vite local para o Spring; em produção, usar origem única ou configurar CORS.
VITE_API_URL=/
VITE_KEYCLOAK_URL=http://localhost:8081
VITE_KEYCLOAK_REALM=bethel-report
VITE_KEYCLOAK_CLIENT_ID=bethel-report-frontend
VITE_AUTH_REDIRECT_URI=http://localhost:3000/admission/complete
VITE_AUTH_LOGOUT_REDIRECT_URI=http://localhost:3000/admission/complete
